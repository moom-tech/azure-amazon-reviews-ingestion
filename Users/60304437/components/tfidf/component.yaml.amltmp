$schema: https://azuremlschemas.azureedge.net/latest/commandComponent.schema.json
name: tfidf_feature_engineering
display_name: TF-IDF Feature Engineering
type: command
inputs:
  train_data:
    type: uri_folder
  val_data:
    type: uri_folder
  test_data:
    type: uri_folder
  max_features:
    type: integer
    default: 1000
outputs:
  train_out:
    type: uri_folder
  val_out:
    type: uri_folder
  test_out:
    type: uri_folder
code: .
environment: azureml:AzureML-sklearn-1.1-ubuntu20.04-py38-cpu@latest
command: >
  python tfidf_features.py 
  --train_data ${{inputs.train_data}} 
  --val_data ${{inputs.val_data}} 
  --test_data ${{inputs.test_data}}
  --max_features ${{inputs.max_features}}
  --train_out ${{outputs.train_out}}
  --val_out ${{outputs.val_out}}
  --test_out ${{outputs.test_out}}